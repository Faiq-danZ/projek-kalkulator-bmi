<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER_LEFT" prefHeight="480.0" prefWidth="700.0" spacing="15.0" style="-fx-background-color: #F0F4F8; -fx-border-color: #BFDBFE; -fx-background-radius: 12; -fx-padding: 18;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.projek.kalkulator.bmi.PrimaryController">
   <padding>
      <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
   </padding>
   <children>
      <Label alignment="CENTER" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1E3A8A; -fx-font-family: Segoe UI;" text="Kalkulator BMI">
         <VBox.margin>
            <Insets left="250.0" />
         </VBox.margin>
         <font>
            <Font name="Segoe UI Bold" size="12.0" />
         </font></Label>
      <Label contentDisplay="TOP" style="-fx-text-fill: #1E293B; -fx-font-weight: bold; -fx-font-size: 20;" text="Berat Badan (kg):" />
      <TextField fx:id="txtBerat" promptText="Masukkan berat (contoh: 65)" style="-fx-background-color: white; -fx-border-color: #93C5FD; -fx-border-radius: 8; -fx-padding: 8; -fx-font-size: 15;" />
      <Label style="-fx-text-fill: #1E293B; -fx-font-weight: bold; -fx-font-size: 20;" text="Tinggi Badan (cm):" />
      <TextField fx:id="txtTinggi" promptText="Masukkan tinggi dalam cm (contoh: 170)" style="-fx-background-color: white; -fx-border-color: #93C5FD; -fx-border-radius: 8; -fx-padding: 8; -fx-font-size: 15;" />
      <HBox prefHeight="100.0" prefWidth="200.0">
         <children>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="711.0" spacing="15.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#handleHitung" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 30 8 30; -fx-font-size: 15;" text="Hitung BMI" />
                  <Button mnemonicParsing="false" onAction="#handleReset" style="-fx-background-color: #DBEAFE; -fx-text-fill: #1E40AF; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 30 8 30; -fx-font-size: 15;" text="Reset" />
               </children>
            </HBox>
         </children>
      </HBox>
      <VBox alignment="CENTER_LEFT" prefHeight="179.0" prefWidth="662.0" spacing="8.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #93C5FD;">
         <children>
            <Label fx:id="lblNilaiBMI" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E3A8A;" text="Nilai BMI : -">
               <VBox.margin>
                  <Insets bottom="50.0" left="50.0" top="30.0" />
               </VBox.margin>
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
               <padding>
                  <Insets bottom="-10.0" />
               </padding>
            </Label>
            <Label fx:id="lblKategori" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E3A8A;" text="Kategori : -">
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
               <VBox.margin>
                  <Insets bottom="40.0" left="50.0" />
               </VBox.margin>
               <padding>
                  <Insets bottom="-10.0" />
               </padding>
            </Label>
         </children>
      </VBox>
   </children>
</VBox>
